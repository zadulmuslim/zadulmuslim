# ─────────────────────────────────────────────────────────────
# Zadulmuslim (যাদুল মুসলিম) — environment variables
# Copy to .env.local for local development. Set the same keys in
# Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for metadata, Open Graph, auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase: PostgreSQL database + Auth ONLY (all files go to Cloudflare R2) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare R2: all file and media storage (server-only) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public custom domain bound to the bucket, e.g. https://media.zadulmuslim.com
# (no trailing slash). Only objects under public prefixes are served here.
R2_PUBLIC_URL=

# Optional (recommended): a second R2 bucket with NO public domain, used for
# "authenticated" and "private" files. If empty, private files are stored under
# private/ in R2_BUCKET_NAME — then block /private/* on the public domain.
R2_PRIVATE_BUCKET_NAME=

# Optional: secret for the daily cleanup cron (Vercel sends it automatically).
CRON_SECRET=
